        import librosa
        from resemblyzer import VoiceEncoder, preprocess_wav
    except ImportError as exc:
        raise RuntimeError(
            "Voice recognition dependencies are not installed. Install the backend requirements."
        ) from exc
    return librosa, VoiceEncoder, preprocess_wav

